# Copy to .env.local. This file is never served to the browser.
# Optional override; otherwise read the verified Secrets Manager secret below.
VOICE_SWAP_API_KEY=
VOICE_SWAP_API_KEY_SECRET=voice-swap-dev/api-key
VOICE_SWAP_BASE_URL=http://voice-swap-dev.develop.internal
# Preserve the private ALB host route when using an approved local tunnel.
VOICE_SWAP_UPSTREAM_HOST=voice-swap-dev.develop.internal

# Use your existing HOOK AWS CLI/SSO profile, or standard AWS environment
# credentials. The bridge uses the documented us-east-2 region.
AWS_PROFILE=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
